GEMINI_API_KEY=your_key_here

# Optional model overrides
GEMINI_DEVELOPER_MODEL=gemini-2.5-flash-lite
GEMINI_MAINTAINER_MODEL=gemini-2.5-flash-lite
GEMINI_JUDGE_MODEL=gemini-2.5-flash-lite

# Optional generation settings
GEMINI_MAX_OUTPUT_TOKENS=1600
GEMINI_TEMPERATURE=0.0
GEMINI_RATE_LIMIT_SECONDS=4.5

# Optional dataset and experiment settings
HUMANEVAL_DATASET=openai_humaneval
CURATION_SIZE=50
CURATION_SEED=42
CORRECTNESS_TIMEOUT_SECONDS=10.0
RUN2_DEFAULT_TASK_LIMIT=15
